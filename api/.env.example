# Copy to .env and fill in. See ../SETUP.md for how to obtain each value.
# .env is gitignored at the repo root.

# --- MongoDB Atlas (SETUP.md §1) -------------------------------------------
# Must include the database name (/xenon) before the query string, and the
# password must be percent-encoded if it has special characters.
MONGO_URI=

# --- Resend (SETUP.md §2) --------------------------------------------------
RESEND_API_KEY=
# The shared sandbox sender below needs no DNS setup, but only delivers to the
# email address you registered your Resend account with.
RESEND_FROM=Xenon <onboarding@resend.dev>

# --- Google OAuth (SETUP.md §3) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server ---------------------------------------------------------------
PORT=4001

# --- Optional: defaults shown, override only if you change ports ----------
# Must match the Authorized redirect URI in the Google Cloud console exactly.
# GOOGLE_REDIRECT_URI=http://localhost:4001/auth/google/callback
# Where the Google callback sends the browser once the cookie is set.
# POST_LOGIN_REDIRECT=http://localhost:3000/app
# NODE_ENV=development
