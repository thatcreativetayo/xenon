# Copy to .env and fill in. See ../SETUP.md for how to obtain each value.
# .env is gitignored at the repo root.

# --- MongoDB Atlas (SETUP.md §1) -------------------------------------------
# Must include the database name (/xenon) before the query string, and the
# password must be percent-encoded if it has special characters.
MONGO_URI=

# --- Resend (SETUP.md §2) --------------------------------------------------
RESEND_API_KEY=
# The shared sandbox sender below needs no DNS setup, but only delivers to the
# email address you registered your Resend account with.
RESEND_FROM=Xenon <onboarding@resend.dev>

# --- Google OAuth (SETUP.md §3) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Secret encryption at rest --------------------------------------------
# 32 bytes of key material, hex or base64. Generate with: openssl rand -hex 32
# Required — the server refuses to boot without it, because the alternative is
# silently writing environment secrets and auth credentials as plaintext.
# Changing this key makes every already-encrypted secret unreadable.
ENCRYPTION_KEY=

# --- Paystack (pro plan billing) ------------------------------------------
# Secret key from the Paystack dashboard (sk_test_... in test mode). Used for
# Initialize/Verify Transaction calls and to verify webhook signatures.
PAYSTACK_SECRET_KEY=

# --- Server ---------------------------------------------------------------
PORT=4001

# --- Optional: defaults shown, override only if you change ports ----------
# Must match the Authorized redirect URI in the Google Cloud console exactly.
# GOOGLE_REDIRECT_URI=http://localhost:4001/auth/google/callback
# Where the Google callback sends the browser once the cookie is set.
# POST_LOGIN_REDIRECT=http://localhost:3000/app
# Base URL of the Next.js app; invite links and billing redirects are built from it.
# FRONTEND_URL=http://localhost:3000
# Externally reachable base URL of this API; Paystack returns the payer here.
# API_URL=http://localhost:4001
# Per-user cap on /api/execute calls per minute.
# EXECUTE_RATE_LIMIT_PER_MINUTE=60
# NODE_ENV=development
